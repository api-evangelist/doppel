          "name": "List Protected Assets",
          "request": {
            "name": "List Protected Assets",
            "description": {
              "content": "List protected assets for the authenticated organization. Filter by platform and/or brand IDs/brand names, with pagination support. Protected assets are URLs, handles, or identifiers that your organization wants to monitor for unauthorized use across various platforms.",
              "type": "text/plain"
            },
